// EV Vision — a Tesla-inspired, minimalist EV cockpit for Ola Dash.
// Fixed 1280x768 layout. The host owns the top 48 px telltale strip.
import { Vehicle, Media, Actions, Battery, Ride, DriveMode, VehicleState, Navigation, Plugins, Display, OverlayPlacement, OverlayStyle, Telltale, LockStyle, LockKeyShape, LockDigits } from "vehicle.slint";

export { Vehicle, Media, Actions, DriveMode, Battery, Ride, Navigation, Plugins }

export component Dash inherits Window {
    width: 1280px;
    height: 768px;
    background: page;
    default-font-family: "Arial";

    // Display.night is driven by the host's Off / On / Auto setting.
    // Auto follows the configured local schedule (default 19:00–06:30).
    property <bool> night: Display.night;
    property <color> page: night ? page : #f2f6f4;
    property <color> panel: night ? panel : ink;
    property <color> panel-raised: night ? panel-raised : #e9efed;
    property <color> border: night ? border : #d6e0dc;
    property <color> border-strong: night ? border-strong : #c5d3cd;
    property <color> ink: night ? ink : #17231f;
    property <color> muted: night ? muted : #62736c;
    property <color> soft: night ? soft : #71827b;
    property <color> scooter-mint: #8fd8c7;
    property <color> scooter-dark: scooter-dark;
    property <color> wheel-fill: night ? page : #dce5e1;
    property <color> wheel-outline: night ? muted : #50645b;
    property <color> scooter-trim: night ? scooter-trim : #45554e;
    property <color> danger: danger;
    property <color> danger-soft: night ? danger-soft : #f2c9c7;

    property <bool> charge-view: Vehicle.charging || Vehicle.state == VehicleState.charging;
    property <bool> parked: !charge-view && (Vehicle.state == VehicleState.park || Vehicle.mode == DriveMode.park);
    property <bool> reversing: Vehicle.mode == DriveMode.reverse;
    property <bool> easy-parking: Vehicle.mode == DriveMode.easy-park;
    property <bool> trunk-ready: Vehicle.state == VehicleState.park && Vehicle.speed-kmh == 0 && !Vehicle.trunk-open;
    property <color> accent: charge-view ? #43d6a0 : danger;
    property <float> speed-shown: Vehicle.speed-kmh;
    animate speed-shown { duration: 420ms; easing: ease-out; }
    property <float> battery-shown: max(0, Vehicle.battery-pct);
    animate battery-shown { duration: 700ms; easing: ease-in-out; }
    property <float> battery-fraction: clamp(battery-shown / 100, 0, 1);

    out property <OverlayPlacement> overlay-placement: OverlayPlacement.top;
    out property <[Telltale]> telltale-order: [
        Telltale.left-indicator, Telltale.right-indicator, Telltale.ready,
        Telltale.high-beam, Telltale.headlight, Telltale.side-stand,
        Telltale.fault, Telltale.locked, Telltale.charging,
    ];
    out property <OverlayStyle> overlay-style: {
        background: page,
        foreground: ink,
        corner-radius: 8px,
        show-labels: true,
    };
    out property <LockStyle> lock-style: {
        background: page,
        foreground: ink,
        muted: muted,
        accent: danger,
        key-background: panel-raised,
        key-border: border,
        key-shape: LockKeyShape.rounded,
        digits: LockDigits.sans,
    };

    // Header — deliberately clear of the host telltale strip.
    Text {
        x: 64px; y: 70px; width: 260px; height: 48px;
        text: Vehicle.clock-text == "" ? "--:--" : Vehicle.clock-text;
        color: ink; font-size: 36px; font-weight: 600;
    }
    Text {
        x: 64px; y: 116px; width: 260px; height: 26px;
        text: Vehicle.data-stale ? "VEHICLE DATA UNAVAILABLE" : "OLA ELECTRIC";
        color: Vehicle.data-stale ? danger : muted;
        font-size: 16px; font-weight: 600; letter-spacing: 2px;
    }
    Rectangle { x: 64px; y: 158px; width: 1152px; height: 1px; background: border; }

    // Speed panel.
    Text {
        x: 64px; y: 214px; width: 330px; height: 190px;
        horizontal-alignment: left; vertical-alignment: center;
        text: charge-view ? (Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown))
            : parked ? "P" : reversing ? "R" : "" + round(speed-shown);
        color: ink;
        font-size: (parked || reversing) ? 176px : 164px;
        font-weight: 600; letter-spacing: -7px;
    }
    Text {
        x: 72px; y: 402px; width: 300px; height: 34px;
        text: charge-view ? "CHARGING" : parked ? "PARKED" : reversing ? "REVERSE" : easy-parking ? "EASY PARK" : "km/h";
        color: charge-view ? #43d6a0 : soft;
        font-size: 24px; font-weight: 500; letter-spacing: 2px;
    }
    Text {
        x: 72px; y: 450px; width: 300px; height: 30px;
        visible: parked;
        text: "Press power button to ride";
        color: muted; font-size: 18px;
    }
    Text {
        x: 72px; y: 500px; width: 300px; height: 24px;
        text: "TRIP";
        color: muted; font-size: 14px; font-weight: 600; letter-spacing: 2px;
    }
    Text {
        x: 72px; y: 526px; width: 300px; height: 40px;
        text: "" + round(Vehicle.trip-km * 10) / 10 + " km";
        color: ink; font-size: 28px; font-weight: 500;
    }

    // Centre vehicle / navigation canvas. Restrained line-art, not a fake map.
    Rectangle {
        x: 430px; y: 190px; width: 470px; height: 350px;
        border-radius: 22px; background: panel;
        border-width: 1px; border-color: border-strong;
    }
    // Soft red ambient horizon line, matching the EV Vision reference.
    Rectangle {
        x: 454px; y: 438px; width: 422px; height: 2px;
        border-radius: 1px; background: danger-soft;
    }
    Text {
        x: 462px; y: 214px; width: 406px; height: 24px;
        text: Navigation.active ? "NAVIGATION" : "VEHICLE";
        color: muted; font-size: 14px; font-weight: 600; letter-spacing: 2px;
    }
    // Side profile inspired by the first-generation Ola S1 Pro.
    // Neo Mint body panels, black saddle, twin wheels, front cowl and rear top-box.
    if !Navigation.active : Rectangle {
        x: 548px; y: 350px; width: 70px; height: 70px;
        border-radius: 35px; background: wheel-fill;
        border-width: 5px; border-color: wheel-outline;
    }
    if !Navigation.active : Rectangle {
        x: 573px; y: 375px; width: 20px; height: 20px;
        border-radius: 10px; background: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 728px; y: 350px; width: 70px; height: 70px;
        border-radius: 35px; background: wheel-fill;
        border-width: 5px; border-color: wheel-outline;
    }
    if !Navigation.active : Rectangle {
        x: 753px; y: 375px; width: 20px; height: 20px;
        border-radius: 10px; background: scooter-trim;
    }
    // Low floorboard and rear swingarm.
    if !Navigation.active : Rectangle {
        x: 592px; y: 340px; width: 154px; height: 15px;
        border-radius: 7px; background: scooter-mint;
    }
    if !Navigation.active : Rectangle {
        x: 704px; y: 346px; width: 56px; height: 8px;
        border-radius: 4px; background: scooter-trim;
    }
    // Gen-1 front apron and leg shield.
    if !Navigation.active : Rectangle {
        x: 584px; y: 285px; width: 55px; height: 70px;
        border-radius: 22px; background: scooter-mint;
        border-width: 2px; border-color: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 592px; y: 300px; width: 8px; height: 35px;
        border-radius: 4px; background: #d8f5ec;
    }
    // Steering column, handlebar and mirrors.
    if !Navigation.active : Rectangle {
        x: 589px; y: 252px; width: 8px; height: 55px;
        border-radius: 4px; background: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 565px; y: 250px; width: 58px; height: 8px;
        border-radius: 4px; background: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 568px; y: 234px; width: 4px; height: 18px;
        border-radius: 2px; background: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 559px; y: 230px; width: 20px; height: 8px;
        border-radius: 4px; background: scooter-dark;
        border-width: 1px; border-color: scooter-trim;
    }
    // Saddle and mint rear side panel.
    if !Navigation.active : Rectangle {
        x: 628px; y: 276px; width: 94px; height: 16px;
        border-radius: 8px; background: scooter-dark;
    }
    if !Navigation.active : Rectangle {
        x: 665px; y: 297px; width: 76px; height: 48px;
        border-radius: 18px; background: scooter-mint;
        border-width: 2px; border-color: scooter-trim;
    }
    if !Navigation.active : Text {
        x: 680px; y: 310px; width: 48px; height: 20px;
        horizontal-alignment: center; vertical-alignment: center;
        text: "OLA"; color: #244f45; font-size: 12px; font-weight: 700;
    }
    // Headlamp, tail lamp and Gen-1 rear storage box.
    if !Navigation.active : Rectangle {
        x: 580px; y: 294px; width: 12px; height: 18px;
        border-radius: 5px; background: #e9fff8;
    }
    if !Navigation.active : Rectangle {
        x: 733px; y: 307px; width: 10px; height: 14px;
        border-radius: 4px; background: danger;
    }
    if !Navigation.active : Rectangle {
        x: 704px; y: 286px; width: 62px; height: 10px;
        border-radius: 5px; background: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 716px; y: 263px; width: 48px; height: 28px;
        border-radius: 7px; background: scooter-dark;
        border-width: 2px; border-color: scooter-trim;
    }
    if !Navigation.active : Rectangle {
        x: 721px; y: 259px; width: 38px; height: 6px;
        border-radius: 3px; background: scooter-trim;
    }
    if Navigation.active : Text {
        x: 466px; y: 278px; width: 398px; height: 104px;
        text: Navigation.instruction;
        color: ink; font-size: 30px; font-weight: 600;
        wrap: word-wrap; overflow: elide;
    }
    if Navigation.active : Text {
        x: 466px; y: 410px; width: 398px; height: 44px;
        text: Navigation.distance + "   ·   " + Navigation.eta;
        color: danger; font-size: 22px; font-weight: 600;
    }

    // Right-side energy and range.
    Rectangle {
        x: 928px; y: 190px; width: 288px; height: 164px;
        border-radius: 18px; background: panel;
        border-width: 1px; border-color: border;
    }
    Text { x: 952px; y: 212px; width: 240px; height: 24px; text: "BATTERY"; color: muted; font-size: 14px; font-weight: 600; letter-spacing: 2px; }
    Text {
        x: 952px; y: 244px; width: 170px; height: 64px;
        text: Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown) + "%";
        color: ink; font-size: 52px; font-weight: 600;
    }
    Rectangle { x: 952px; y: 320px; width: 240px; height: 7px; border-radius: 4px; background: border-strong; }
    Rectangle {
        x: 952px; y: 320px; width: 240px * battery-fraction; height: 7px;
        border-radius: 4px; background: battery-shown < 15 ? danger : ink;
    }
    Rectangle {
        x: 928px; y: 374px; width: 288px; height: 166px;
        border-radius: 18px; background: panel;
        border-width: 1px; border-color: border;
    }
    Text { x: 952px; y: 396px; width: 240px; height: 24px; text: "ESTIMATED RANGE"; color: muted; font-size: 14px; font-weight: 600; letter-spacing: 2px; }
    Text {
        x: 952px; y: 430px; width: 240px; height: 68px;
        text: Vehicle.range-km < 0 ? "--" : "" + Vehicle.range-km;
        color: ink; font-size: 58px; font-weight: 600;
    }
    Text { x: 1080px; y: 466px; width: 100px; height: 28px; text: "km"; color: soft; font-size: 20px; }
    Text {
        x: 952px; y: 506px; width: 240px; height: 22px;
        text: Battery.temp-max-c < 0 ? "PACK TEMP  --" : "PACK TEMP  " + round(Battery.temp-max-c) + "°C";
        color: muted; font-size: 14px; font-weight: 500;
    }

    // Drive-mode state: display only; no vehicle mode-changing controls are exposed by the SDK.
    Rectangle { x: 430px; y: 562px; width: 786px; height: 62px; border-radius: 12px; background: panel; border-width: 1px; border-color: border; }
    Text { x: 454px; y: 581px; width: 120px; height: 24px; text: "DRIVE MODE"; color: muted; font-size: 14px; font-weight: 600; letter-spacing: 1.5px; }
    Text {
        x: 600px; y: 578px; width: 560px; height: 30px;
        text: Vehicle.mode == DriveMode.eco ? "ECO" : Vehicle.mode == DriveMode.normal ? "NORMAL"
            : Vehicle.mode == DriveMode.sport ? "SPORT" : Vehicle.mode == DriveMode.hyper ? "HYPER"
            : Vehicle.mode == DriveMode.custom ? "CUSTOM" : reversing ? "REVERSE" : parked ? "PARK" : "--";
        color: ink; font-size: 22px; font-weight: 600; letter-spacing: 2px;
    }

    // Bottom dock: media, plugin widget, and host actions.
    Rectangle { x: 64px; y: 650px; width: 440px; height: 78px; border-radius: 14px; background: panel-raised; border-width: 1px; border-color: border; }
    Text {
        x: 84px; y: 662px; width: 300px; height: 28px;
        text: Media.title == "" ? "Nothing playing" : Media.title;
        color: ink; font-size: 20px; font-weight: 600; overflow: elide;
    }
    Text {
        x: 84px; y: 692px; width: 300px; height: 22px;
        text: Media.artist == "" ? "Media" : Media.artist;
        color: muted; font-size: 15px; overflow: elide;
    }
    Rectangle { x: 396px; y: 666px; width: 48px; height: 48px; border-radius: 24px; background: border; }
    Text { x: 396px; y: 666px; width: 48px; height: 48px; horizontal-alignment: center; vertical-alignment: center; text: Media.playing ? "Ⅱ" : "▶"; color: ink; font-size: 20px; }
    TouchArea { x: 396px; y: 666px; width: 48px; height: 48px; clicked => { Media.play-pause(); } }

    if Plugins.widgets.length > 0 : Rectangle {
        x: 524px; y: 650px; width: 220px; height: 78px;
        border-radius: 14px; background: panel-raised; border-width: 1px; border-color: border;
        Text { x: 544px; y: 662px; width: 180px; height: 22px; text: Plugins.widgets[0].title; color: muted; font-size: 14px; overflow: elide; }
        Text { x: 544px; y: 688px; width: 180px; height: 28px; text: Plugins.widgets[0].value + " " + Plugins.widgets[0].unit; color: ink; font-size: 20px; font-weight: 600; overflow: elide; }
        TouchArea { x: 524px; y: 650px; width: 220px; height: 78px; clicked => { Plugins.widget-clicked(Plugins.widgets[0].id); } }
    }

    Rectangle { x: 768px; y: 650px; width: 142px; height: 78px; border-radius: 14px; background: panel-raised; border-width: 1px; border-color: border-strong; }
    Text { x: 768px; y: 650px; width: 142px; height: 78px; horizontal-alignment: center; vertical-alignment: center; text: "Android Auto"; color: ink; font-size: 17px; font-weight: 600; }
    TouchArea { x: 768px; y: 650px; width: 142px; height: 78px; clicked => { Actions.open-android-auto(); } }

    Rectangle {
        x: 926px; y: 650px; width: 142px; height: 78px; border-radius: 14px;
        background: trunk-ready || Vehicle.trunk-open ? panel-raised : panel-raised;
        border-width: 1px; border-color: Vehicle.trunk-open ? danger : border-strong;
        opacity: trunk-ready || Vehicle.trunk-open ? 1 : 0.4;
    }
    // Scooter top-box icon (lid, storage body and latch), not a car boot symbol.
    Rectangle {
        x: 971px; y: 659px; width: 52px; height: 7px;
        border-radius: 3px; background: scooter-trim;
    }
    Rectangle {
        x: 976px; y: 665px; width: 42px; height: 25px;
        border-radius: 5px; background: border;
        border-width: 2px; border-color: scooter-trim;
    }
    Rectangle {
        x: 993px; y: 674px; width: 8px; height: 5px;
        border-radius: 2px; background: danger;
    }
    Text {
        x: 936px; y: 696px; width: 122px; height: 22px;
        horizontal-alignment: center; vertical-alignment: center;
        text: Vehicle.trunk-open ? "Trunk open" : "Trunk";
        color: ink; font-size: 16px; font-weight: 600;
    }
    TouchArea { x: 926px; y: 650px; width: 142px; height: 78px; enabled: trunk-ready; clicked => { Actions.open-trunk(); } }

    Rectangle { x: 1084px; y: 650px; width: 132px; height: 78px; border-radius: 14px; background: panel-raised; border-width: 1px; border-color: border-strong; }
    Text { x: 1084px; y: 650px; width: 132px; height: 78px; horizontal-alignment: center; vertical-alignment: center; text: "Settings"; color: ink; font-size: 17px; font-weight: 600; }
    TouchArea { x: 1084px; y: 650px; width: 132px; height: 78px; clicked => { Actions.open-settings(); } }
}
