// EV Vision — premium glass cockpit for the first-generation Ola S1.
// Fixed 1280x768 canvas. The host owns the top 48 px telltale strip.
import { Vehicle, Media, Actions, Battery, Ride, DriveMode, VehicleState, Navigation, Plugins, Display, OverlayPlacement, OverlayStyle, Telltale, LockStyle, LockKeyShape, LockDigits } from "vehicle.slint";
export { Vehicle, Media, Actions, DriveMode, Battery, Ride, Navigation, Plugins }

export component Dash inherits Window {
    width: 1280px;
    height: 768px;
    background: page;
    default-font-family: "Arial";

    property <bool> night: Display.night;
    property <color> page: night ? #080d13 : #e8f0ed;
    property <color> glass: night ? #17232c : #ffffff;
    property <color> glass-deep: night ? #101a22 : #f6faf8;
    property <color> glass-edge: night ? #52636c : #c5d5cf;
    property <color> glass-highlight: night ? #b9d2d8 : #ffffff;
    property <color> ink: night ? #f3f8f7 : #15241f;
    property <color> muted: night ? #9aadb1 : #60746d;
    property <color> faint: night ? #60757b : #91a39c;
    property <color> mint: #8bdcc8;
    property <color> mint-deep: #4baf9b;
    property <color> mint-glow: night ? #5ce0c2 : #299c83;
    property <color> red: #ff625f;
    property <color> amber: #ffca76;
    property <color> card-edge: night ? #52636c : #c5d5cf;
    property <color> wheel: night ? #11181d : #dce6e1;
    property <color> trim: night ? #b5c5c5 : #3e514b;
    property <color> black: #11191d;

    property <bool> charging: Vehicle.charging || Vehicle.state == VehicleState.charging;
    property <bool> parked: !charging && (Vehicle.state == VehicleState.park || Vehicle.mode == DriveMode.park);
    property <bool> reversing: Vehicle.mode == DriveMode.reverse;
    property <bool> easy-parking: Vehicle.mode == DriveMode.easy-park;
    property <bool> trunk-ready: Vehicle.state == VehicleState.park && Vehicle.speed-kmh == 0 && !Vehicle.trunk-open;
    property <color> accent: charging ? mint-glow : red;
    property <float> speed-shown: Vehicle.speed-kmh;
    animate speed-shown { duration: 420ms; easing: ease-out; }
    property <float> battery-shown: max(0, Vehicle.battery-pct);
    animate battery-shown { duration: 700ms; easing: ease-in-out; }
    property <float> battery-fraction: clamp(battery-shown / 100, 0, 1);
    property <float> media-progress: Media.duration-ms > 0 ? clamp(Media.position-ms / Media.duration-ms, 0, 1) : 0;

    out property <OverlayPlacement> overlay-placement: OverlayPlacement.top;
    out property <[Telltale]> telltale-order: [
        Telltale.left-indicator, Telltale.right-indicator, Telltale.ready,
        Telltale.high-beam, Telltale.headlight, Telltale.charging,
        Telltale.side-stand, Telltale.fault, Telltale.locked,
    ];
    out property <OverlayStyle> overlay-style: {
        background: page, foreground: ink, corner-radius: 12px, show-labels: true,
    };
    out property <LockStyle> lock-style: {
        background: page, foreground: ink, muted: muted, accent: mint-glow,
        key-background: glass-deep.with-alpha(0.94), key-border: glass-edge,
        key-shape: LockKeyShape.rounded, digits: LockDigits.sans,
    };

    // Ambient studio lighting: subtle mint and cool-white pools behind the glass.
    Rectangle {
        x: 0px; y: 48px; width: 1280px; height: 720px; clip: true;
        background: @linear-gradient(135deg, page 0%, night ? #0a141b : #f3f8f5 55%, page 100%);
        Rectangle {
            x: 310px; y: 42px; width: 650px; height: 520px;
            background: @radial-gradient(circle, night ? #2ac9ad.with-alpha(0.14) : #74cbb3.with-alpha(0.19) 0%, transparent 70%);
        }
        Rectangle {
            x: 920px; y: 330px; width: 380px; height: 350px;
            background: @radial-gradient(circle, night ? #6388a0.with-alpha(0.12) : #a8c7bd.with-alpha(0.20) 0%, transparent 72%);
        }
    }

    // Header / identity.
    Text {
        x: 48px; y: 72px; width: 180px; height: 48px;
        text: Vehicle.clock-text == "" ? "--:--" : Vehicle.clock-text;
        color: ink; font-size: 40px; font-weight: 700; letter-spacing: -1px;
    }
    Text {
        x: 50px; y: 116px; width: 390px; height: 24px;
        text: Vehicle.data-stale ? "VEHICLE DATA UNAVAILABLE" : Display.dashboard-model-title;
        color: Vehicle.data-stale ? red : muted; font-size: 15px; font-weight: 700; letter-spacing: 2px;
    }
    Rectangle {
        x: 1034px; y: 78px; width: 198px; height: 42px;
        border-radius: 21px; background: glass-deep.with-alpha(0.82);
        border-width: 1px; border-color: card-edge;
        Rectangle { x: 16px; y: 16px; width: 9px; height: 9px; border-radius: 5px; background: Vehicle.data-stale ? amber : mint-glow; }
        Text {
            x: 0px; y: 9px; width: 198px; height: 24px;
            text: "TESLA V1";
            color: ink; font-size: 16px; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
            letter-spacing: 3px;
        }
    }

    // Speed glass module — layered translucent surfaces and a restrained accent rail.
    Rectangle {
        x: 412px; y: 118px; width: 480px; height: 480px;
        border-radius: 28px; background: glass-deep.with-alpha(0.72);
        border-width: 1px; border-color: card-edge;
    }
    Text { x: 444px; y: 150px; width: 416px; height: 26px; text: charging ? "STATE OF CHARGE" : "LIVE SPEED"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; horizontal-alignment: center; }
    Text {
        x: 436px; y: 205px; width: 432px; height: 200px;
        horizontal-alignment: center; vertical-alignment: center;
        text: charging ? (Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown))
            : parked ? "P" : reversing ? "R" : "" + round(speed-shown);
        color: ink; font-size: (parked || reversing) ? 156px : 150px;
        font-weight: 700; letter-spacing: -7px;
    }
    Text {
        x: 444px; y: 392px; width: 416px; height: 32px;
        text: charging ? "CHARGING" : parked ? "PARKED" : reversing ? "REVERSE" : easy-parking ? "EASY PARK" : "km/h";
        color: charging ? mint-glow : reversing || easy-parking ? amber : muted;
        font-size: 22px; font-weight: 700; letter-spacing: 2px;
        horizontal-alignment: center;
    }
    Rectangle { x: 444px; y: 442px; width: 416px; height: 1px; background: glass-edge.with-alpha(0.55); }
    Text { x: 444px; y: 462px; width: 416px; height: 22px; text: "TRIP DISTANCE"; horizontal-alignment: center; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
    Text { x: 444px; y: 492px; width: 416px; height: 54px; text: "" + round(Vehicle.trip-km * 10) / 10 + " KM"; color: ink; font-size: 32px; font-weight: 700; horizontal-alignment: center; }
    Text { font-weight: 700; x: 444px; y: 554px; width: 416px; height: 22px; visible: parked; text: "TAP POWER TO BEGIN YOUR RIDE"; color: faint; font-size: 15px; horizontal-alignment: center; }

    // Live predicted-range panel replaces the scooter photo.
    Rectangle {
        x: 48px; y: 166px; width: 320px; height: 360px;
        border-radius: 30px; background: glass.with-alpha(0.52);
        border-width: 1px; border-color: card-edge;
    }
    Text {
        x: 72px; y: 198px; width: 272px; height: 30px;
        text: "PREDICTED RANGE";
        color: muted; font-size: 17px; font-weight: 800;
        letter-spacing: 2px; horizontal-alignment: center;
    }
    Text {
        x: 72px; y: 258px; width: 272px; height: 112px;
        text: Vehicle.predicted-range-km < 0 ? "--" : "" + round(Vehicle.predicted-range-km);
        color: ink; font-size: 94px; font-weight: 700;
        letter-spacing: -4px; horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 72px; y: 366px; width: 272px; height: 32px;
        text: "KM"; color: muted; font-size: 23px; font-weight: 700;
        horizontal-alignment: center;
    }
    Rectangle { x: 72px; y: 420px; width: 272px; height: 1px; background: card-edge.with-alpha(0.55); }
    Text {
        x: 72px; y: 442px; width: 272px; height: 22px;
        text: Vehicle.range-calibrated ? "LIVE RIDE EFFICIENCY" : "RANGE TAB BASELINE";
        color: Vehicle.range-calibrated ? mint-glow : muted;
        font-size: 13px; font-weight: 800; letter-spacing: 1px;
        horizontal-alignment: center;
    }
    Text {
        x: 72px; y: 476px; width: 272px; height: 22px;
        text: Vehicle.range-calibrated ? "REFRESHED EVERY 1 KM" : "CALIBRATING · 2 KM OR 2%";
        color: faint; font-size: 11px; font-weight: 700;
        letter-spacing: 0.6px; horizontal-alignment: center;
    }

    // Battery and range stack: glass tiles with crisp information hierarchy.
    Rectangle { x: 916px; y: 166px; width: 316px; height: 198px; border-radius: 26px; background: glass.with-alpha(0.72); border-width: 1px; border-color: card-edge; }
    Text { x: 944px; y: 192px; width: 240px; height: 22px; text: "BATTERY"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text { x: 940px; y: 226px; width: 190px; height: 70px; text: Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown) + "%"; color: ink; font-size: 60px; font-weight: 700; letter-spacing: -2px; }
    Text { x: 944px; y: 300px; width: 240px; height: 20px; text: Vehicle.charging ? "ENERGY FLOW ACTIVE" : "ESTIMATED CHARGE"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
    Rectangle { x: 944px; y: 334px; width: 260px; height: 8px; border-radius: 4px; background: glass-edge.with-alpha(0.45); }
    Rectangle { x: 944px; y: 334px; width: 260px * battery-fraction; height: 8px; border-radius: 4px; background: battery-shown < 15 ? red : mint-glow; }
    Rectangle { x: 916px; y: 386px; width: 316px; height: 204px; border-radius: 26px; background: glass.with-alpha(0.72); border-width: 1px; border-color: card-edge; }
    Text { x: 944px; y: 412px; width: 240px; height: 22px; text: "RANGE TAB ESTIMATE"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text { x: 940px; y: 448px; width: 190px; height: 82px; text: Vehicle.range-km < 0 ? "--" : "" + Vehicle.range-km; color: ink; font-size: 74px; font-weight: 700; letter-spacing: -3px; }
    Text { x: 1090px; y: 492px; width: 90px; height: 28px; text: "KM"; color: muted; font-size: 22px; font-weight: 700; }
    Text { x: 944px; y: 548px; width: 250px; height: 20px; text: Battery.temp-max-c < 0 ? "BATTERY TEMP   --" : "BATTERY TEMP   " + round(Battery.temp-max-c) + "°C"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 0.8px; }

    // Drive mode strip.
    Rectangle { x: 392px; y: 610px; width: 840px; height: 58px; border-radius: 20px; background: glass-deep.with-alpha(0.78); border-width: 1px; border-color: card-edge; }
    Text { x: 416px; y: 610px; width: 150px; height: 58px; text: "DRIVE PROFILE"; color: muted; font-size: 14px; font-weight: 700; letter-spacing: 1.4px; vertical-alignment: center; }
    Rectangle { x: 584px; y: 623px; width: 1px; height: 30px; background: glass-edge.with-alpha(0.6); }
    Text {
        x: 610px; y: 610px; width: 580px; height: 58px; vertical-alignment: center;
        text: Vehicle.mode == DriveMode.eco ? "ECO" : Vehicle.mode == DriveMode.normal ? "NORMAL"
            : Vehicle.mode == DriveMode.sport ? "SPORT" : Vehicle.mode == DriveMode.hyper ? "HYPER"
            : Vehicle.mode == DriveMode.custom ? "CUSTOM" : reversing ? "REVERSE" : parked ? "PARK" : "--";
        color: ink; font-size: 22px; font-weight: 700; letter-spacing: 2px;
    }

    // Expanded music dock fills the space released by the shorter scooter hero panel.
    Rectangle { x: 48px; y: 544px; width: 320px; height: 182px; border-radius: 22px; background: glass.with-alpha(0.78); border-width: 1px; border-color: card-edge; }
    Rectangle { x: 62px; y: 562px; width: 52px; height: 52px; border-radius: 15px; background: @linear-gradient(135deg, mint-glow.with-alpha(0.65) 0%, glass-deep 100%); }
    // Draw the music-note mark with primitives so it never depends on a missing font glyph.
    Rectangle { x: 82px; y: 570px; width: 3px; height: 21px; border-radius: 1px; background: ink; }
    Rectangle { x: 97px; y: 566px; width: 3px; height: 21px; border-radius: 1px; background: ink; }
    Rectangle { x: 83px; y: 566px; width: 17px; height: 3px; border-radius: 1px; background: ink; }
    Rectangle { x: 72px; y: 585px; width: 13px; height: 10px; border-radius: 5px; background: ink; }
    Rectangle { x: 87px; y: 581px; width: 13px; height: 10px; border-radius: 5px; background: ink; }
    Text { x: 128px; y: 560px; width: 210px; height: 28px; text: Media.title == "" ? "NOTHING PLAYING" : Media.title; color: ink; font-size: 19px; font-weight: 700; overflow: elide; }
    Text { x: 128px; y: 590px; width: 210px; height: 24px; text: Media.artist == "" ? "MEDIA PLAYER" : Media.artist; color: muted; font-size: 15px; font-weight: 700; overflow: elide; }
    // Live playback position, refreshed twice per second from Android's active media session.
    Rectangle { x: 62px; y: 626px; width: 292px; height: 4px; border-radius: 2px; background: glass-edge.with-alpha(0.65); }
    Rectangle { x: 62px; y: 626px; width: 292px * media-progress; height: 4px; border-radius: 2px; background: mint-glow; }
    // Larger, easier-to-hit transport and system-volume controls.
    Rectangle { x: 62px; y: 646px; width: 292px; height: 64px; border-radius: 20px; background: glass-deep.with-alpha(0.78); border-width: 1px; border-color: card-edge.with-alpha(0.5); }
    Text { x: 68px; y: 648px; width: 48px; height: 60px; horizontal-alignment: center; vertical-alignment: center; text: "−"; color: ink; font-size: 25px; font-weight: 800; }
    TouchArea { x: 68px; y: 646px; width: 48px; height: 64px; clicked => { Media.volume-down(); } }
    Text { x: 126px; y: 648px; width: 48px; height: 60px; horizontal-alignment: center; vertical-alignment: center; text: "◀|"; color: ink; font-size: 17px; font-weight: 800; }
    TouchArea { x: 126px; y: 646px; width: 48px; height: 64px; clicked => { Media.previous(); } }
    Text { x: 184px; y: 648px; width: 48px; height: 60px; horizontal-alignment: center; vertical-alignment: center; text: Media.playing ? "Ⅱ" : "▶"; color: mint-glow; font-size: 21px; font-weight: 800; }
    TouchArea { x: 184px; y: 646px; width: 48px; height: 64px; clicked => { Media.play-pause(); } }
    Text { x: 242px; y: 648px; width: 48px; height: 60px; horizontal-alignment: center; vertical-alignment: center; text: "|▶"; color: ink; font-size: 17px; font-weight: 800; }
    TouchArea { x: 242px; y: 646px; width: 48px; height: 64px; clicked => { Media.next(); } }
    Text { x: 300px; y: 648px; width: 48px; height: 60px; horizontal-alignment: center; vertical-alignment: center; text: "+"; color: ink; font-size: 24px; font-weight: 800; }
    TouchArea { x: 300px; y: 646px; width: 48px; height: 64px; clicked => { Media.volume-up(); } }
    Rectangle { x: 392px; y: 686px; width: 840px; height: 40px; border-radius: 20px; background: glass-deep.with-alpha(0.58); border-width: 1px; border-color: card-edge; }
    Text { x: 408px; y: 686px; width: 160px; height: 40px; text: "MOD BY M@DDY"; color: muted; font-size: 17px; font-weight: 800; letter-spacing: 1.1px; vertical-alignment: center; }
    Text { x: 588px; y: 686px; width: 190px; height: 40px; text: Vehicle.odometer-km < 0 ? "ODO  -- KM" : "ODO  " + round(Vehicle.odometer-km) + " KM"; color: muted; font-size: 17px; font-weight: 800; vertical-alignment: center; }
    Text { x: 786px; y: 686px; width: 190px; height: 40px; text: Battery.temp-max-c < 0 ? "BATTERY TEMP  --°C" : "BATTERY TEMP  " + round(Battery.temp-max-c) + "°C"; color: muted; font-size: 17px; font-weight: 800; vertical-alignment: center; }
    Rectangle { x: 988px; y: 686px; width: 112px; height: 40px; border-radius: 17px; background: glass.with-alpha(0.88); border-width: 1px; border-color: card-edge; }
    Text { x: 988px; y: 686px; width: 112px; height: 40px; horizontal-alignment: center; vertical-alignment: center; text: "AA  ↗"; color: ink; font-size: 16px; font-weight: 700; }
    TouchArea { x: 988px; y: 686px; width: 112px; height: 40px; clicked => { Actions.open-android-auto(); } }
    Rectangle { x: 1110px; y: 686px; width: 122px; height: 40px; border-radius: 17px; background: trunk-ready || Vehicle.trunk-open ? glass.with-alpha(0.88) : glass-deep.with-alpha(0.55); border-width: 1px; border-color: Vehicle.trunk-open ? red : card-edge; opacity: trunk-ready || Vehicle.trunk-open ? 1 : 0.45; }
    // Factory-style scooter boot/storage icon, resized to sit neatly inside the footer pill.
    Rectangle { x: 1156px; y: 696px; width: 30px; height: 10px; border-radius: 3px; background: glass-edge; border-width: 1px; border-color: trim; }
    Rectangle { x: 1159px; y: 698px; width: 24px; height: 2px; background: glass-highlight; }
    Rectangle { x: 1155px; y: 691px; width: 31px; height: 3px; border-radius: 2px; background: Vehicle.trunk-open ? red : trim; }
    Rectangle { x: 1157px; y: 688px; width: 26px; height: 3px; border-radius: 1px; background: trim; }
    Rectangle { x: 1168px; y: 693px; width: 5px; height: 2px; border-radius: 1px; background: ink; }
    Text { x: 1114px; y: 707px; width: 114px; height: 14px; horizontal-alignment: center; text: Vehicle.trunk-open ? "BOOT OPEN" : "BOOT"; color: ink; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
    TouchArea { x: 1110px; y: 686px; width: 122px; height: 40px; enabled: trunk-ready; clicked => { Actions.open-trunk(); } }
}
