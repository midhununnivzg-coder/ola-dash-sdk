// EV Vision — premium glass cockpit for the first-generation Ola S1.
// Fixed 1280x768 canvas. The host owns the top 48 px telltale strip.
import { Vehicle, Media, Actions, Battery, Ride, DriveMode, VehicleState, Navigation, Plugins, Display, OverlayPlacement, OverlayStyle, Telltale, LockStyle, LockKeyShape, LockDigits } from "vehicle.slint";
export { Vehicle, Media, Actions, DriveMode, Battery, Ride, Navigation, Plugins }

export component Dash inherits Window {
    width: 1280px;
    height: 768px;
    background: page;
    default-font-family: "Arial";

    property <bool> night: Display.night;
    property <color> page: night ? #080d13 : #e8f0ed;
    property <color> glass: night ? #17232c : #ffffff;
    property <color> glass-deep: night ? #101a22 : #f6faf8;
    property <color> glass-edge: night ? #52636c : #c5d5cf;
    property <color> glass-highlight: night ? #b9d2d8 : #ffffff;
    property <color> ink: night ? #f3f8f7 : #15241f;
    property <color> muted: night ? #9aadb1 : #60746d;
    property <color> faint: night ? #60757b : #91a39c;
    property <color> mint: #8bdcc8;
    property <color> mint-deep: #4baf9b;
    property <color> mint-glow: night ? #5ce0c2 : #299c83;
    property <color> red: #ff625f;
    property <color> amber: #ffca76;
    property <color> wheel: night ? #11181d : #dce6e1;
    property <color> trim: night ? #b5c5c5 : #3e514b;
    property <color> black: #11191d;

    property <bool> charging: Vehicle.charging || Vehicle.state == VehicleState.charging;
    property <bool> parked: !charging && (Vehicle.state == VehicleState.park || Vehicle.mode == DriveMode.park);
    property <bool> reversing: Vehicle.mode == DriveMode.reverse;
    property <bool> easy-parking: Vehicle.mode == DriveMode.easy-park;
    property <bool> trunk-ready: Vehicle.state == VehicleState.park && Vehicle.speed-kmh == 0 && !Vehicle.trunk-open;
    property <color> accent: charging ? mint-glow : red;
    property <float> speed-shown: Vehicle.speed-kmh;
    animate speed-shown { duration: 420ms; easing: ease-out; }
    property <float> battery-shown: max(0, Vehicle.battery-pct);
    animate battery-shown { duration: 700ms; easing: ease-in-out; }
    property <float> battery-fraction: clamp(battery-shown / 100, 0, 1);

    out property <OverlayPlacement> overlay-placement: OverlayPlacement.top;
    out property <[Telltale]> telltale-order: [
        Telltale.left-indicator, Telltale.right-indicator, Telltale.ready,
        Telltale.high-beam, Telltale.headlight, Telltale.side-stand,
        Telltale.fault, Telltale.locked, Telltale.charging,
    ];
    out property <OverlayStyle> overlay-style: {
        background: page, foreground: ink, corner-radius: 12px, show-labels: true,
    };
    out property <LockStyle> lock-style: {
        background: page, foreground: ink, muted: muted, accent: mint-glow,
        key-background: glass-deep.with-alpha(0.94), key-border: glass-edge,
        key-shape: LockKeyShape.rounded, digits: LockDigits.sans,
    };

    // Ambient studio lighting: subtle mint and cool-white pools behind the glass.
    Rectangle {
        x: 0px; y: 48px; width: 1280px; height: 720px; clip: true;
        background: @linear-gradient(135deg, page 0%, night ? #0a141b : #f3f8f5 55%, page 100%);
        Rectangle {
            x: 310px; y: 42px; width: 650px; height: 520px;
            background: @radial-gradient(circle, night ? #2ac9ad.with-alpha(0.14) : #74cbb3.with-alpha(0.19) 0%, transparent 70%);
        }
        Rectangle {
            x: 920px; y: 330px; width: 380px; height: 350px;
            background: @radial-gradient(circle, night ? #6388a0.with-alpha(0.12) : #a8c7bd.with-alpha(0.20) 0%, transparent 72%);
        }
    }

    // Header / identity.
    Text {
        x: 48px; y: 72px; width: 180px; height: 48px;
        text: Vehicle.clock-text == "" ? "--:--" : Vehicle.clock-text;
        color: ink; font-size: 40px; font-weight: 700; letter-spacing: -1px;
    }
    Text {
        x: 50px; y: 116px; width: 390px; height: 24px;
        text: Vehicle.data-stale ? "VEHICLE DATA UNAVAILABLE" : "SUPER SCOOTER S1 PRO";
        color: Vehicle.data-stale ? red : muted; font-size: 15px; font-weight: 700; letter-spacing: 2px;
    }
    Rectangle {
        x: 1034px; y: 78px; width: 198px; height: 42px;
        border-radius: 21px; background: glass-deep.with-alpha(0.82);
        border-width: 1px; border-color: glass-edge.with-alpha(0.72);
        Rectangle { x: 16px; y: 16px; width: 9px; height: 9px; border-radius: 5px; background: Vehicle.data-stale ? amber : mint-glow; }
        Text {
            x: 0px; y: 9px; width: 198px; height: 24px;
            text: "TESLA";
            color: ink; font-size: 16px; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
            letter-spacing: 3px;
        }
    }

    // Speed glass module — layered translucent surfaces and a restrained accent rail.
    Rectangle {
        x: 392px; y: 166px; width: 320px; height: 424px;
        border-radius: 28px; background: glass-deep.with-alpha(0.72);
        border-width: 1px; border-color: glass-edge.with-alpha(0.72);
    }
    Rectangle {
        x: 394px; y: 168px; width: 316px; height: 2px;
        border-radius: 1px; background: glass-highlight.with-alpha(0.48);
    }
    Rectangle {
        x: 392px; y: 166px; width: 5px; height: 424px;
        border-radius: 2px; background: charging ? mint-glow : night ? #91a9b4 : #83b8aa;
    }
    Text { x: 420px; y: 192px; width: 240px; height: 24px; text: charging ? "STATE OF CHARGE" : "LIVE SPEED"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text {
        x: 414px; y: 248px; width: 276px; height: 174px;
        horizontal-alignment: left; vertical-alignment: center;
        text: charging ? (Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown))
            : parked ? "P" : reversing ? "R" : "" + round(speed-shown);
        color: ink; font-size: (parked || reversing) ? 156px : 150px;
        font-weight: 700; letter-spacing: -7px;
    }
    Text {
        x: 424px; y: 412px; width: 240px; height: 30px;
        text: charging ? "CHARGING" : parked ? "PARKED" : reversing ? "REVERSE" : easy-parking ? "EASY PARK" : "km/h";
        color: charging ? mint-glow : reversing || easy-parking ? amber : muted;
        font-size: 22px; font-weight: 700; letter-spacing: 2px;
    }
    Rectangle { x: 424px; y: 464px; width: 256px; height: 1px; background: glass-edge.with-alpha(0.55); }
    Text { x: 424px; y: 482px; width: 120px; height: 20px; text: "TRIP DISTANCE"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
    Text { x: 424px; y: 510px; width: 200px; height: 42px; text: "" + round(Vehicle.trip-km * 10) / 10 + " km"; color: ink; font-size: 32px; font-weight: 700; }
    Text { font-weight: 700; x: 424px; y: 558px; width: 250px; height: 20px; visible: parked; text: "Tap power to begin your ride"; color: faint; font-size: 15px; }

    // Hero glass stage with the mint S1 silhouette.
    Rectangle {
        x: 48px; y: 166px; width: 500px; height: 424px;
        border-radius: 30px; background: glass.with-alpha(0.52);
        border-width: 1px; border-color: glass-highlight.with-alpha(0.55);
    }
    Rectangle {
        x: 50px; y: 168px; width: 496px; height: 2px;
        border-radius: 1px; background: glass-highlight.with-alpha(0.7);
    }
    Text { x: 78px; y: 192px; width: 330px; height: 24px; text: Navigation.active ? "ROUTE GUIDANCE" : "MIDHUN SANKAR'S S1 PRO"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text { x: 416px; y: 192px; width: 100px; height: 24px; horizontal-alignment: right; text: "4 KWH"; color: faint; font-size: 14px; font-weight: 700; letter-spacing: 1px; }
    // Real first-generation S1 Pro photo supplied for this theme.
    // Keep the image inside the hero glass stage; navigation replaces it when active.
    if !Navigation.active : Image {
        x: 86px; y: 220px; width: 424px; height: 286px;
        source: @image-url("assets/ola-s1-neo-mint.jpg");
        image-fit: contain;
    }
    Rectangle { x: 86px; y: 482px; width: 424px; height: 1px; background: glass-edge.with-alpha(0.38); }
    if Navigation.active : Text {
        x: 86px; y: 280px; width: 424px; height: 112px;
        text: Navigation.instruction; color: ink; font-size: 32px; font-weight: 700;
        wrap: word-wrap; overflow: elide;
    }
    if Navigation.active : Text {
        x: 86px; y: 414px; width: 424px; height: 38px;
        text: Navigation.distance + "   ·   " + Navigation.eta;
        color: mint-glow; font-size: 24px; font-weight: 700;
    }
    Text { x: 78px; y: 520px; width: 440px; height: 22px; text: Navigation.active ? "FOLLOW THE ROUTE" : "NEO MINT BLUE"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 1.6px; }

    // Battery and range stack: glass tiles with crisp information hierarchy.
    Rectangle { x: 916px; y: 166px; width: 316px; height: 198px; border-radius: 26px; background: glass.with-alpha(0.72); border-width: 1px; border-color: glass-highlight.with-alpha(0.62); }
    Rectangle { x: 918px; y: 168px; width: 312px; height: 2px; background: glass-highlight.with-alpha(0.65); }
    Text { x: 944px; y: 192px; width: 240px; height: 22px; text: "BATTERY"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text { x: 940px; y: 226px; width: 190px; height: 70px; text: Vehicle.battery-pct < 0 ? "--" : "" + round(battery-shown) + "%"; color: ink; font-size: 60px; font-weight: 700; letter-spacing: -2px; }
    Text { x: 944px; y: 300px; width: 240px; height: 20px; text: Vehicle.charging ? "ENERGY FLOW ACTIVE" : "ESTIMATED CHARGE"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
    Rectangle { x: 944px; y: 334px; width: 260px; height: 8px; border-radius: 4px; background: glass-edge.with-alpha(0.45); }
    Rectangle { x: 944px; y: 334px; width: 260px * battery-fraction; height: 8px; border-radius: 4px; background: battery-shown < 15 ? red : mint-glow; }
    Rectangle { x: 916px; y: 386px; width: 316px; height: 204px; border-radius: 26px; background: glass.with-alpha(0.72); border-width: 1px; border-color: glass-highlight.with-alpha(0.62); }
    Rectangle { x: 918px; y: 388px; width: 312px; height: 2px; background: glass-highlight.with-alpha(0.65); }
    Text { x: 944px; y: 412px; width: 240px; height: 22px; text: "ESTIMATED RANGE"; color: muted; font-size: 15px; font-weight: 700; letter-spacing: 2px; }
    Text { x: 940px; y: 448px; width: 190px; height: 82px; text: Vehicle.range-km < 0 ? "--" : "" + Vehicle.range-km; color: ink; font-size: 74px; font-weight: 700; letter-spacing: -3px; }
    Text { x: 1090px; y: 492px; width: 90px; height: 28px; text: "km"; color: muted; font-size: 22px; font-weight: 700; }
    Text { x: 944px; y: 548px; width: 250px; height: 20px; text: Battery.temp-max-c < 0 ? "PACK TEMPERATURE   --" : "PACK TEMPERATURE   " + round(Battery.temp-max-c) + "°C"; color: muted; font-size: 13px; font-weight: 700; letter-spacing: 0.8px; }

    // Drive mode strip.
    Rectangle { x: 392px; y: 610px; width: 840px; height: 58px; border-radius: 20px; background: glass-deep.with-alpha(0.78); border-width: 1px; border-color: glass-edge.with-alpha(0.65); }
    Text { x: 416px; y: 628px; width: 130px; height: 22px; text: "DRIVE PROFILE"; color: muted; font-size: 14px; font-weight: 700; letter-spacing: 1.4px; }
    Rectangle { x: 564px; y: 623px; width: 1px; height: 30px; background: glass-edge.with-alpha(0.6); }
    Text {
        x: 590px; y: 624px; width: 600px; height: 28px;
        text: Vehicle.mode == DriveMode.eco ? "ECO" : Vehicle.mode == DriveMode.normal ? "NORMAL"
            : Vehicle.mode == DriveMode.sport ? "SPORT" : Vehicle.mode == DriveMode.hyper ? "HYPER"
            : Vehicle.mode == DriveMode.custom ? "CUSTOM" : reversing ? "REVERSE" : parked ? "PARK" : "--";
        color: ink; font-size: 22px; font-weight: 700; letter-spacing: 2px;
    }

    // Bottom dock — compact floating glass controls.
    Rectangle { x: 48px; y: 614px; width: 320px; height: 112px; border-radius: 22px; background: glass.with-alpha(0.78); border-width: 1px; border-color: glass-highlight.with-alpha(0.55); }
    Rectangle { x: 62px; y: 630px; width: 48px; height: 48px; border-radius: 14px; background: @linear-gradient(135deg, mint-glow.with-alpha(0.65) 0%, glass-deep 100%); }
    Text { x: 62px; y: 630px; width: 48px; height: 48px; horizontal-alignment: center; vertical-alignment: center; text: "♫"; color: ink; font-size: 27px; font-weight: 700; }
    Text { x: 124px; y: 628px; width: 204px; height: 25px; text: Media.title == "" ? "Nothing playing" : Media.title; color: ink; font-size: 18px; font-weight: 700; overflow: elide; }
    Text { x: 124px; y: 654px; width: 204px; height: 20px; text: Media.artist == "" ? "Media player" : Media.artist; color: muted; font-size: 14px; font-weight: 700; overflow: elide; }
    // Dedicated transport and system-volume controls.
    Rectangle { x: 62px; y: 686px; width: 266px; height: 28px; border-radius: 14px; background: glass-deep.with-alpha(0.78); border-width: 1px; border-color: glass-edge.with-alpha(0.5); }
    Text { x: 70px; y: 687px; width: 36px; height: 26px; horizontal-alignment: center; vertical-alignment: center; text: "−"; color: ink; font-size: 22px; font-weight: 800; }
    TouchArea { x: 66px; y: 685px; width: 44px; height: 30px; clicked => { Media.volume-down(); } }
    Text { x: 116px; y: 687px; width: 42px; height: 26px; horizontal-alignment: center; vertical-alignment: center; text: "◀|"; color: ink; font-size: 15px; font-weight: 800; }
    TouchArea { x: 112px; y: 685px; width: 48px; height: 30px; clicked => { Media.previous(); } }
    Text { x: 164px; y: 687px; width: 42px; height: 26px; horizontal-alignment: center; vertical-alignment: center; text: Media.playing ? "Ⅱ" : "▶"; color: mint-glow; font-size: 18px; font-weight: 800; }
    TouchArea { x: 160px; y: 685px; width: 48px; height: 30px; clicked => { Media.play-pause(); } }
    Text { x: 212px; y: 687px; width: 42px; height: 26px; horizontal-alignment: center; vertical-alignment: center; text: "|▶"; color: ink; font-size: 15px; font-weight: 800; }
    TouchArea { x: 208px; y: 685px; width: 48px; height: 30px; clicked => { Media.next(); } }
    Text { x: 264px; y: 687px; width: 36px; height: 26px; horizontal-alignment: center; vertical-alignment: center; text: "+"; color: ink; font-size: 21px; font-weight: 800; }
    TouchArea { x: 258px; y: 685px; width: 48px; height: 30px; clicked => { Media.volume-up(); } }

    Rectangle { x: 392px; y: 686px; width: 840px; height: 40px; border-radius: 20px; background: glass-deep.with-alpha(0.58); border-width: 1px; border-color: glass-edge.with-alpha(0.5); }
    Text { x: 408px; y: 692px; width: 160px; height: 28px; text: "OLA  /  EV VISION"; color: muted; font-size: 17px; font-weight: 800; letter-spacing: 1.1px; }
    Text { x: 588px; y: 692px; width: 190px; height: 28px; text: Vehicle.odometer-km < 0 ? "ODO  -- km" : "ODO  " + round(Vehicle.odometer-km) + " km"; color: muted; font-size: 17px; font-weight: 800; }
    Text { x: 786px; y: 692px; width: 190px; height: 28px; text: Battery.temp-max-c < 0 ? "PACK  --°C" : "PACK  " + round(Battery.temp-max-c) + "°C"; color: muted; font-size: 17px; font-weight: 800; }

    Rectangle { x: 988px; y: 678px; width: 112px; height: 48px; border-radius: 17px; background: glass.with-alpha(0.88); border-width: 1px; border-color: glass-edge.with-alpha(0.65); }
    Text { x: 988px; y: 678px; width: 112px; height: 48px; horizontal-alignment: center; vertical-alignment: center; text: "AA  ↗"; color: ink; font-size: 16px; font-weight: 700; }
    TouchArea { x: 988px; y: 678px; width: 112px; height: 48px; clicked => { Actions.open-android-auto(); } }

    Rectangle { x: 1110px; y: 678px; width: 122px; height: 48px; border-radius: 17px; background: trunk-ready || Vehicle.trunk-open ? glass.with-alpha(0.88) : glass-deep.with-alpha(0.55); border-width: 1px; border-color: Vehicle.trunk-open ? red : glass-edge.with-alpha(0.65); opacity: trunk-ready || Vehicle.trunk-open ? 1 : 0.45; }
    // Factory-style scooter boot/storage icon: open hinged lid and deep compartment.
    Rectangle { x: 1156px; y: 696px; width: 30px; height: 13px; border-radius: 3px; background: glass-edge; border-width: 1px; border-color: trim; }
    Rectangle { x: 1159px; y: 699px; width: 24px; height: 2px; background: glass-highlight; }
    Rectangle { x: 1155px; y: 690px; width: 31px; height: 4px; border-radius: 2px; background: Vehicle.trunk-open ? red : trim; }
    Rectangle { x: 1157px; y: 687px; width: 26px; height: 3px; border-radius: 1px; background: trim; }
    Rectangle { x: 1168px; y: 693px; width: 5px; height: 3px; border-radius: 1px; background: ink; }
    Text { x: 1114px; y: 710px; width: 114px; height: 13px; horizontal-alignment: center; text: Vehicle.trunk-open ? "BOOT OPEN" : "BOOT"; color: ink; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
    TouchArea { x: 1110px; y: 678px; width: 122px; height: 48px; enabled: trunk-ready; clicked => { Actions.open-trunk(); } }
}
